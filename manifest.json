{
  "id": "./",
  "name": "J.A.R.V.I.S. Command",
  "short_name": "JARVIS",
  "description": "Networking Technologies command deck. Talk to J.A.R.V.I.S. and send files straight into his quickshare through the wetransfer system.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#05080e",
  "theme_color": "#05080e",
  "categories": ["productivity", "utilities", "communication"],
  "share_target": {
    "action": "./index.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "shared-files",
          "accept": ["*/*"]
        }
      ]
    }
  },
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}
